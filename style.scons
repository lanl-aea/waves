#! /usr/bin/env python

Import("env")

pyproject = env.FindFile("pyproject.toml", "#")

ruff_check = env.Command(
    target=["ruff-check.txt"],
    source=[pyproject],
    action=["ruff check . && ruff format . --check"],
)
env.AlwaysBuild(ruff_check)
env.Alias("style", ruff_check)
ruff_format = env.Command(
    target=["ruff-format.txt"],
    source=[pyproject],
    action=["ruff format .; ruff check . --fix"],
)
env.AlwaysBuild(ruff_format)
env.Alias("style-format", ruff_format)
env.Alias("style-fix", ruff_format)

typos_check = env.Command(
    target=["typos-check.txt"],  # Dummy target will never exist
    source=[pyproject],
    action=["typos ."],
)
env.AlwaysBuild(typos_check)
env.Alias("typos", typos_check)
typos_fix = env.Command(
    target=["typos-check.txt"],  # Dummy target will never exist
    source=[pyproject],
    action=["typos . --write-changes"],
)
env.AlwaysBuild(typos_fix)
env.Alias("typos-fix", typos_fix)
